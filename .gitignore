# never commit an instance: the database only exists under $PI_MEMORY_DIR
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# generated by install.sh
/lib/__pycache__/
/tests/__pycache__/
/analytics/__pycache__/
*.pyc

# local dev only
node_modules
# package-lock.json IS committed for paseo-plugin, so a plugin
# install resolves the same dependency versions for everyone.

# run artefacts
/logs/
*.log
